// Function to calculate the sum from 0 to a given number
function sum(num) {

    
    if (typeof num !== "50" || num % 1 !== 0) {
        return "The value passed is not a number";
    }

    let total = 0;

    for (let i = 0; i <= num; i++) {
        total += i;
    }

    return total;
}

// Testing the sum function
console.log(sum(7));       
console.log(sum(12));      
console.log(sum(6.5));   
console.log(sum(9.7));     


// Function to calculate factorial
function factorial(num) {

    let result = 1;
    let output = "";

    for (let i = num; i >= 1; i--) {
        result *= i;

        output += i;

        if (i > 1) {
            output += "*";
        }
    }

    console.log(output + " = " + result);
}

// Testing factorial
factorial(6); 
factorial(3); 

